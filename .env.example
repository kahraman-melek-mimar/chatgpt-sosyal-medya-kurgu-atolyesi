# Bu dosyayı .env olarak kopyalayın ve doldurun. .env GitHub'a gitmez (.gitignore).
# Anahtarları kimseyle paylaşmayın; sohbete de yapıştırmayın.

# ElevenLabs → Profile → API Keys
ELEVENLABS_API_KEY=
# ElevenLabs → Voices → sesinizin "ID" değeri (klonladığınız sesiniz)
ELEVENLABS_VOICE_ID=
# İsteğe bağlı: varsayılan library/ilan-ses-ayarlari.json → eleven_multilingual_v2
ELEVENLABS_MODEL_ID=
# İsteğe bağlı: ElevenLabs'e yüklenmiş telaffuz sözlüğü
ELEVENLABS_DICTIONARY_ID=
ELEVENLABS_DICTIONARY_VERSION_ID=

# HeyGen → Settings → API
HEYGEN_API_KEY=
# HeyGen → Avatars → kendi avatarınızın ID'si
HEYGEN_AVATAR_ID=
